{
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.md",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/prototypes/index.html"
    },
    {
      "src": "/sms-template",
      "dest": "/prototypes/%E6%A8%A1%E6%9D%BF%E7%B0%A1%E8%A8%8A%E8%A8%AD%E5%AE%9A%E6%95%99%E5%AD%B8.html"
    },
    {
      "src": "/appointment",
      "dest": "/prototypes/%E9%A0%90%E7%B4%84%E6%93%8D%E4%BD%9C%E6%A8%A1%E6%93%AC.html"
    },
    {
      "src": "/prototypes/(.*)",
      "dest": "/prototypes/$1"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/docs/$1"
    },
    {
      "src": "/(.*\\.md)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
